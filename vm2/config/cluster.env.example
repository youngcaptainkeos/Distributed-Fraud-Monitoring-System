# Cluster Environment Configuration Template
# Copy this file to `config/.env` and fill in the assigned ZeroTier IP addresses.
# Note: `config/.env` is ignored by Git to prevent leaking internal IPs.

# Run Identifier (change per run: run1, run2, run3, run4, run5)
# Proposed mapping:
#   run1: Baseline (clean in-order live stream)
#   run2: Experiment 1 (Executor Failure & recovery)
#   run3: Experiment 2 (Spark Master/Driver Restart from same checkpoint)
#   run4: Experiment 3 (Event Disorder < 1 minute)
#   run5: Experiment 4 (Event Disorder > 1 minute)
RUN_ID=run1

# VM1 (Kafka Broker & Transaction Producer)
# Assigned ZeroTier IP: 172.23.211.163
KAFKA_BOOTSTRAP_SERVERS=<VM1_IP>:9092
KAFKA_TOPIC=transactions-run1
KAFKA_STARTING_OFFSETS=earliest

# VM2 (Spark Master & Driver)
# Assigned ZeroTier IP: 172.23.124.232
SPARK_MASTER_URL=spark://<VM2_IP>:7077
SPARK_APP_NAME=FraudDetectionEngine-run1

# VM3 (HDFS NameNode & Iceberg Catalog)
# Assigned ZeroTier IP: 172.23.222.173
HDFS_NAMENODE=hdfs://<VM3_IP>:9000
ICEBERG_CATALOG_NAME=iceberg
ICEBERG_WAREHOUSE=hdfs://<VM3_IP>:9000/warehouse
CHECKPOINT_LOCATION=hdfs://<VM3_IP>:9000/checkpoints/run1

# Iceberg Target Tables
DECISIONS_TABLE=iceberg.default.transaction_decisions_run1
ALERTS_TABLE=iceberg.default.account_risk_alerts_run1

# Streaming Micro-Batch Trigger (agreed with VM1 producer hold delays)
TRIGGER_INTERVAL=10 seconds
