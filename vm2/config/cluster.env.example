# Cluster Environment Configuration Example
# Copy to .env and adjust private IPs for your lab VM deployment

# Run Identifier (change per run: run1, run2, run3, run4, baseline)
RUN_ID=run1

# VM1 (Kafka Broker & Producer)
KAFKA_BOOTSTRAP_SERVERS=172.23.138.248:9092
KAFKA_TOPIC=transactions-run1
KAFKA_STARTING_OFFSETS=earliest

# VM2 (Spark Master & Driver)
SPARK_MASTER_URL=spark://172.23.138.248:7077
SPARK_APP_NAME=FraudDetectionEngine-run1

# VM3 (HDFS & Iceberg Storage)
HDFS_NAMENODE=hdfs://172.23.138.248:9000
ICEBERG_CATALOG_NAME=iceberg
ICEBERG_WAREHOUSE=hdfs://172.23.138.248:9000/warehouse
CHECKPOINT_LOCATION=hdfs://172.23.138.248:9000/checkpoints/run1

# Table Names
DECISIONS_TABLE=iceberg.default.transaction_decisions_run1
ALERTS_TABLE=iceberg.default.account_risk_alerts_run1

# Streaming Trigger
TRIGGER_INTERVAL=10 seconds
